{
  "name": "tmdb-movie-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bash setup.sh",
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "server": "cd server && node index.js",
    "client": "cd client && npm run dev",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "concurrently": "^8.2.1",
    "jsonwebtoken": "^9.0.2",
    "redis": "^5.9.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.3",
    "cross-env": "^7.0.3",
    "vitest": "^3.2.4"
  }
}
